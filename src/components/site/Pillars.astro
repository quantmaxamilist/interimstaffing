---
import { home } from '../../data/site';
---
<section class="pil">
  <div class="container">
    <ol class="pil__grid">
      {home.pillars.map((p, i) => (
        <li class="pil__item" data-reveal data-reveal-delay={String(i * 0.06)}>
          <span class="label pil__n">0{i + 1}</span>
          <h3 class="pil__h">{p.h}</h3>
          <p class="pil__p">{p.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .pil { background: var(--c-burgundy); color: var(--c-paper); padding-block: var(--section); }
  .pil__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid rgba(250,248,245,.22); }
  .pil__item { padding: var(--sp-6) var(--sp-5) 0 0; border-right: 1px solid rgba(250,248,245,.14); padding-left: var(--sp-5); }
  .pil__item:first-child { padding-left: 0; }
  .pil__item:last-child { border-right: 0; }
  .pil__n { color: var(--c-gold); }
  .pil__h { font-size: clamp(1.25rem, 1rem + .6vw, 1.625rem); margin: var(--sp-5) 0 var(--sp-4); line-height: 1.1; }
  .pil__p { color: rgba(250,248,245,.78); }
  @media (max-width: 1000px) { .pil__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .pil__item:nth-child(2) { border-right: 0; } .pil__item:nth-child(3) { padding-left: 0; } .pil__item { padding-bottom: var(--sp-6); } }
  @media (max-width: 560px) { .pil__grid { grid-template-columns: minmax(0, 1fr); } .pil__item { border-right: 0; padding-left: 0; border-bottom: 1px solid rgba(250,248,245,.14); } }
</style>
