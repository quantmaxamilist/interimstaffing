---
// Google reviews band. Renders only from real data in site.ts (google.*). In production it is hidden
// until there is at least one review or a Google link; in dev it shows empty slots so the layout can
// be judged. Reviews must be copied verbatim from the Google profile.
import { google, type Review } from '../../data/site';
interface Props { audience?: 'employer' | 'candidate'; tone?: 'paper' | 'paper-2' }
const { audience, tone = 'paper-2' } = Astro.props;
const all = google.reviews;
// Prefer reviews for this page's audience, then the rest; show up to 3.
const list: Review[] = audience ? [...all.filter((r) => r.audience === audience), ...all.filter((r) => r.audience !== audience)].slice(0, 3) : all.slice(0, 3);
const hasLinks = !!(google.profileUrl || google.reviewUrl);
const live = list.length > 0 || hasLinks;
const preview = !live && import.meta.env.DEV;
const stars = (n: number) => '★★★★★'.slice(0, Math.round(n)) + '☆☆☆☆☆'.slice(0, 5 - Math.round(n));
---
{(live || preview) && (
  <section class:list={['rv', `rv--${tone}`, { 'rv--preview': preview }]} aria-labelledby="rv-h">
    <div class="container">
      <div class="rv__head">
        <div>
          <p class="label rv__label" data-reveal>Google reviews</p>
          <h2 class="rv__h" id="rv-h" data-reveal>What people say about Interim Staffing</h2>
        </div>
        <div class="rv__score" data-reveal>
          <svg class="rv__g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8c-.5 2.8-2.1 5.1-4.4 6.7v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.2z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.6-3.8-12.3-9H4.4v5.7C8 41.1 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.7 28.3c-.4-1.3-.7-2.7-.7-4.3s.3-3 .7-4.3V14H4.4C2.9 17 2 20.4 2 24s.9 7 2.4 10l7.3-5.7z"/><path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3C34.9 4.2 29.9 2 24 2 15.4 2 8 6.9 4.4 14l7.3 5.7c1.7-5.2 6.6-8.9 12.3-8.9z"/></svg>
          {google.rating != null ? (
            <span class="rv__num"><strong>{google.rating.toFixed(1)}</strong> <span class="rv__stars" aria-hidden="true">{stars(google.rating)}</span><span class="rv__count">{google.count} reviews on Google</span></span>
          ) : (
            <span class="rv__num"><span class="rv__count">{preview ? 'Rating appears here once added' : 'Reviews on Google'}</span></span>
          )}
        </div>
      </div>

      <ul class="rv__grid">
        {list.length > 0
          ? list.map((r, i) => (
              <li class="rv__card" data-reveal data-reveal-delay={String(i * 0.06)}>
                <span class="rv__stars rv__stars--card" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</span>
                <blockquote class="rv__text">{r.text}</blockquote>
                <p class="rv__who"><span>{r.author}</span><span class="label">{r.date}</span></p>
              </li>
            ))
          : preview && [0, 1, 2].map(() => (
              <li class="rv__card rv__card--slot" aria-hidden="true"><span class="label">Google review slot</span><span>Paste a real review into <code>google.reviews</code> in site.ts</span></li>
            ))}
      </ul>

      <div class="rv__actions" data-reveal>
        {(google.profileUrl || preview) && <a class="btn btn--burgundy" href={google.profileUrl || '#'} target="_blank" rel="noopener">Read all reviews on Google <span class="arr">→</span></a>}
        {(google.reviewUrl || preview) && <a class="btn btn--ghost rv__write" href={google.reviewUrl || '#'} target="_blank" rel="noopener">Leave a review</a>}
      </div>
    </div>
  </section>
)}
<style>
  .rv { padding-block: var(--section); background: var(--c-paper); }
  .rv--paper-2 { background: var(--c-paper-2); }
  .rv__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--sp-5); margin-bottom: var(--sp-7); }
  .rv__label { color: var(--c-burgundy); }
  .rv__h { font-size: var(--fs-display-3); color: var(--c-burgundy); margin-top: var(--sp-4); max-width: 20ch; }
  .rv__score { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-3) var(--sp-4); background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); }
  .rv__g { width: 32px; height: 32px; flex: none; }
  .rv__num { display: grid; gap: 2px; line-height: 1.2; }
  .rv__num strong { font-family: var(--f-display); font-size: 1.5rem; font-weight: 800; }
  .rv__stars { color: var(--c-gold); letter-spacing: .1em; }
  .rv__count { font-size: var(--fs-small); color: var(--c-ink-2); }
  .rv__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); }
  .rv__card { display: grid; align-content: start; gap: var(--sp-4); padding: var(--sp-6); background: #fff; border: 1px solid var(--c-line); border-top: 3px solid var(--c-gold); border-radius: var(--radius); }
  .rv__stars--card { font-size: 1.125rem; }
  .rv__text { margin: 0; color: var(--c-ink); font-size: var(--fs-body-lg); line-height: 1.55; }
  .rv__who { display: flex; justify-content: space-between; gap: var(--sp-3); align-items: baseline; font-weight: 500; }
  .rv__who .label { color: var(--c-ink-2); }
  .rv__card--slot { min-height: 220px; border: 1.5px dashed rgba(124,1,32,.35); border-top-width: 1.5px; background: transparent; align-content: center; justify-items: center; text-align: center; color: var(--c-ink-2); font-size: var(--fs-small); }
  .rv__card--slot .label { color: var(--c-burgundy); }
  .rv__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-7); }
  .rv__write { color: var(--c-burgundy); }
  @media (max-width: 900px) { .rv__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
