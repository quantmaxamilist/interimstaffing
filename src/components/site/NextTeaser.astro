---
interface Props { label: string; title: string; href: string }
const { label, title, href } = Astro.props;
---
<a class="nt" href={href}>
  <div class="container nt__inner">
    <span class="label nt__label">Next — {label}</span>
    <span class="nt__title">{title}</span>
    <span class="nt__arr" aria-hidden="true">→</span>
  </div>
</a>
<style>
  .nt { display: block; background: var(--c-deep); color: var(--c-paper); text-decoration: none; padding-block: var(--sp-8); border-top: 1px solid var(--c-line-inv); }
  .nt__inner { position: relative; display: grid; gap: var(--sp-3); padding-right: 4rem; }
  .nt__label { color: var(--c-gold); }
  .nt__title { font-family: var(--f-display); font-weight: 800; font-size: var(--fs-display-3); line-height: 1.05; transition: color var(--dur) var(--ease-out); }
  .nt__arr { position: absolute; right: var(--gutter); top: 50%; translate: 0 -50%; font-size: var(--fs-display-3); color: var(--c-gold); transition: transform var(--dur) var(--ease-out); }
  .nt:hover .nt__title { color: var(--c-gold); }
  .nt:hover .nt__arr { transform: translateX(8px); }
</style>
