---
import Logo from './Logo.astro';
import { nav, company, legalEntity, google } from '../../data/site';
const a = legalEntity.address;
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <a href="/" aria-label="Interim Staffing — home" class="ftr__logo"><Logo /></a>
      <p class="ftr__sectors label">{company.sectors.join(' · ')}</p>
    </div>
    <div>
      <h4 class="ftr__h label">Contact</h4>
      <p>Phone: <a href={company.phoneHref}>{company.phone}</a></p>
      <p>Email: <a href={`mailto:${company.email}`} class="ftr__mail">{company.email}</a></p>
    </div>
    <div>
      <h4 class="ftr__h label">Pages</h4>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h4 class="ftr__h label">More Links</h4>
      <ul>
        <li><a href="/legal-notice">Legal Notice</a></li><li><a href="/privacy-policy">Privacy Policy</a></li>
        {google.profileUrl && <li><a href={google.profileUrl} target="_blank" rel="noopener">Google reviews</a></li>}
        {google.reviewUrl && <li><a href={google.reviewUrl} target="_blank" rel="noopener">Leave a Google review</a></li>}
      </ul>
    </div>
  </div>
  <div class="container ftr__base">
    <p>{company.copyright}</p>
    <p class="ftr__legal">{legalEntity.legalName} · Registered in {legalEntity.registeredIn}, company no. <a href={legalEntity.companiesHouseUrl} target="_blank" rel="noopener">{legalEntity.companyNumber}</a> · Registered office: {a.streetAddress}, {a.addressLocality}, {a.postalCode}</p>
  </div>
</footer>
<style>
  .ftr { background: var(--c-stage); color: rgba(250, 248, 245, 0.78); padding-top: var(--sp-9); }
  .ftr__grid { display: grid; grid-template-columns: 1.6fr 1.4fr 1fr 1fr; gap: var(--sp-7); padding-bottom: var(--sp-8); }
  .ftr__logo { text-decoration: none; font-size: 1.375rem; }
  .ftr__sectors { margin-top: var(--sp-5); color: rgba(250,248,245,.5); }
  .ftr__h { color: var(--c-gold); margin-bottom: var(--sp-4); font-family: var(--f-mono); font-weight: 500; letter-spacing: .12em; }
  .ftr a { text-decoration: none; transition: color var(--dur-fast); }
  .ftr a:hover { color: var(--c-gold); }
  .ftr li + li { margin-top: var(--sp-2); }
  .ftr p + p { margin-top: var(--sp-2); }
  .ftr__mail { overflow-wrap: anywhere; }
  .ftr__base { border-top: 1px solid var(--c-line-inv); padding-block: var(--sp-5); font-size: var(--fs-small); color: rgba(250,248,245,.5); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--sp-2) var(--sp-5); }
  .ftr__legal a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .ftr__grid { grid-template-columns: minmax(0, 1fr); gap: var(--sp-6); } }
</style>
