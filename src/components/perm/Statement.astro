---
interface Props { text: string; label?: string }
const { text, label } = Astro.props;
---
<section class="sm">
  <div class="container sm__inner">
    <span class="sm__bar" aria-hidden="true"></span>
    <div>
      {label && <p class="label sm__label" data-reveal>{label}</p>}
      <p class="sm__t" data-reveal>{text}</p>
    </div>
  </div>
</section>
<style>
  .sm { background: var(--c-stage); color: var(--c-paper); padding-block: var(--section); }
  .sm__inner { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); }
  .sm__bar { width: 12px; background: var(--c-gold); }
  .sm__label { color: var(--c-gold); margin-bottom: var(--sp-5); }
  .sm__t { font-family: var(--f-display); font-weight: 800; font-size: var(--fs-statement); line-height: 1.3; max-width: 40ch; letter-spacing: -0.01em; }
</style>
