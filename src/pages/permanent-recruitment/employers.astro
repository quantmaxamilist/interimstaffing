---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/site/PageHero.astro';
import Split from '../../components/site/Split.astro';
import EnquiryBand from '../../components/site/EnquiryBand.astro';
import NextTeaser from '../../components/site/NextTeaser.astro';
import Reviews from '../../components/site/Reviews.astro';
import Steps from '../../components/perm/Steps.astro';
import SectorRows from '../../components/perm/SectorRows.astro';
import { perm, clients } from '../../data/site';
const p = perm.employers;
const s = clients.sections[1];
---
<Base title={p.title} description={p.meta} crumbs={[{ name: 'Permanent Recruitment', href: '/permanent-recruitment' }, { name: 'Employers', href: '/permanent-recruitment/employers' }]} service={{ name: 'Permanent recruitment for employers', description: p.intro }}>
  <PageHero label="Permanent · for employers" title={p.h1} intro={p.intro} image="interview-panel" position="50% 35%" cta={{ label: 'Contact now', href: '/contact?type=permanent&who=employer' }} />
  <Steps label="How it works" title="A permanent hire, step by step" steps={perm.employerSteps} />
  <Split index={1} h2={s.h2} body={s.body} image="forklift" flip tone="paper-2" />
  <SectorRows />
  <Reviews audience="employer" />
  <EnquiryBand text={p.cta} href="/contact?type=permanent&who=employer" />
  <NextTeaser label="For job seekers" title="Find a Permanent Role" href="/permanent-recruitment/candidates" />
</Base>
